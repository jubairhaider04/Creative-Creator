rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Inquiries and CRM leads
    match /inquiries/{inquiryId} {
      allow read, write: if true;
    }
    match /leads/{leadId} {
      allow read, write: if true;
    }
    // Saved AI Project Plans & Scopes
    match /user_ai_plans/{planId} {
      allow read, write: if true;
    }
    // Blog Comments and Claps
    match /blog_comments/{commentId} {
      allow read, write: if true;
    }
    match /blog_claps/{clapId} {
      allow read, write: if true;
    }
    // Newsletter subscribers
    match /newsletter_subscribers/{subId} {
      allow read, write: if true;
    }
    // User profile metadata
    match /users/{userId} {
      allow read, write: if true;
    }
    // Default open for prototype
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
