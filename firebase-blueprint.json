{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered user profile with role-based authorization",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth user unique ID" },
        "email": { "type": "string", "format": "email", "description": "User email address" },
        "displayName": { "type": "string", "description": "Full name of the user" },
        "fullName": { "type": "string", "description": "Full name of the user" },
        "photoURL": { "type": "string", "description": "User avatar image URL" },
        "avatarUrl": { "type": "string", "description": "User avatar image URL" },
        "phone": { "type": "string", "description": "User contact phone number" },
        "company": { "type": "string", "description": "Client company name" },
        "companyName": { "type": "string", "description": "Client company name" },
        "country": { "type": "string", "description": "Client country location" },
        "website": { "type": "string", "description": "Client company website" },
        "role": { "type": "string", "enum": ["admin", "client"], "description": "User access role" },
        "status": { "type": "string", "enum": ["active", "inactive", "suspended"], "description": "Account status" },
        "createdAt": { "type": "string", "description": "ISO timestamp of user creation" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last profile update" },
        "lastLoginAt": { "type": "string", "description": "Timestamp of last authentication" }
      },
      "required": ["uid", "email", "role", "status"]
    },
    "ServiceRequest": {
      "title": "ServiceRequest",
      "description": "Client requested digital service scope and attachments",
      "type": "object",
      "properties": {
        "clientId": { "type": "string", "description": "Client Firebase UID" },
        "clientName": { "type": "string", "description": "Client full name" },
        "clientEmail": { "type": "string", "description": "Client email address" },
        "service": { "type": "string", "description": "Selected digital discipline" },
        "projectTitle": { "type": "string", "description": "Title of requested project" },
        "description": { "type": "string", "description": "Detailed project brief" },
        "budget": { "type": "string", "description": "Estimated budget tier" },
        "deadline": { "type": "string", "description": "Target completion date" },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "urgent"], "description": "Priority level" },
        "status": { "type": "string", "enum": ["new", "reviewing", "approved", "in_progress", "waiting_for_client", "completed", "cancelled"], "description": "Workflow status" },
        "attachments": { "type": "array", "description": "Uploaded attachment URLs" },
        "assignedTo": { "type": "string", "description": "Staff or admin assignee" },
        "notes": { "type": "string", "description": "Internal notes" },
        "createdAt": { "type": "string", "description": "Timestamp of request" },
        "updatedAt": { "type": "string", "description": "Timestamp of last update" }
      },
      "required": ["clientId", "clientEmail", "service", "projectTitle", "status"]
    },
    "ClientProject": {
      "title": "ClientProject",
      "description": "Active production sprint or delivered client project",
      "type": "object",
      "properties": {
        "clientId": { "type": "string", "description": "Associated client UID" },
        "clientName": { "type": "string", "description": "Associated client name" },
        "projectName": { "type": "string", "description": "Project title" },
        "service": { "type": "string", "description": "Primary service discipline" },
        "description": { "type": "string", "description": "Project specifications" },
        "status": { "type": "string", "enum": ["planning", "in_progress", "review", "completed", "paused", "cancelled"], "description": "Sprint status" },
        "progress": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Percentage progress integer" },
        "startDate": { "type": "string", "description": "Sprint kick-off date" },
        "deadline": { "type": "string", "description": "Target delivery deadline" },
        "budget": { "type": "string", "description": "Approved budget" },
        "assignedTo": { "type": "string", "description": "Lead engineer or designer" },
        "deliverables": { "type": "array", "description": "Handover deliverables list" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last update timestamp" }
      },
      "required": ["clientId", "projectName", "status", "progress"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Direct communication message between client and studio admin",
      "type": "object",
      "properties": {
        "conversationId": { "type": "string", "description": "Conversation thread ID" },
        "senderId": { "type": "string", "description": "Message sender UID" },
        "senderName": { "type": "string", "description": "Sender display name" },
        "senderRole": { "type": "string", "enum": ["client", "admin"], "description": "Sender role" },
        "receiverId": { "type": "string", "description": "Message recipient UID" },
        "message": { "type": "string", "description": "Message body text" },
        "attachments": { "type": "array", "description": "Attached file URLs" },
        "read": { "type": "boolean", "description": "Read receipt flag" },
        "createdAt": { "type": "string", "description": "Sent timestamp" }
      },
      "required": ["senderId", "receiverId", "message", "createdAt"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Inbound inquiry message from public contact form",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Visitor full name" },
        "email": { "type": "string", "format": "email", "description": "Visitor email address" },
        "phone": { "type": "string", "description": "Phone or WhatsApp number" },
        "company": { "type": "string", "description": "Company name" },
        "subject": { "type": "string", "description": "Inquiry subject" },
        "message": { "type": "string", "description": "Inquiry message content" },
        "status": { "type": "string", "enum": ["new", "read", "replied", "archived"], "description": "Processing status" },
        "createdAt": { "type": "string", "description": "Submission timestamp" }
      },
      "required": ["name", "email", "message", "status"]
    },
    "TestimonialDoc": {
      "title": "TestimonialDoc",
      "description": "Client testimonial and satisfaction review",
      "type": "object",
      "properties": {
        "clientId": { "type": "string", "description": "Author client UID" },
        "clientName": { "type": "string", "description": "Author full name" },
        "company": { "type": "string", "description": "Client business organization" },
        "testimonial": { "type": "string", "description": "Review text" },
        "rating": { "type": "number", "minimum": 1, "maximum": 5, "description": "Star rating out of 5" },
        "imageUrl": { "type": "string", "description": "Client photo URL" },
        "published": { "type": "boolean", "description": "Public visibility flag" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Update timestamp" }
      },
      "required": ["clientName", "testimonial", "rating", "published"]
    },
    "AppNotification": {
      "title": "AppNotification",
      "description": "In-app notifications for projects, requests, and updates",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Target recipient UID" },
        "title": { "type": "string", "description": "Notification headline" },
        "message": { "type": "string", "description": "Detailed notification body" },
        "type": { "type": "string", "enum": ["info", "success", "warning", "request", "project"], "description": "Notification category" },
        "read": { "type": "boolean", "description": "Read status flag" },
        "link": { "type": "string", "description": "Target internal app route" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["userId", "title", "message", "read", "createdAt"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Audit trail log of administrative and client actions",
      "type": "object",
      "properties": {
        "actorId": { "type": "string", "description": "UID of user performing action" },
        "actorRole": { "type": "string", "description": "Role of user performing action" },
        "action": { "type": "string", "description": "Name of action executed" },
        "entityType": { "type": "string", "description": "Target resource type" },
        "entityId": { "type": "string", "description": "Target resource ID" },
        "description": { "type": "string", "description": "Audit description text" },
        "createdAt": { "type": "string", "description": "Audit timestamp" }
      },
      "required": ["actorId", "action", "entityType", "createdAt"]
    },
    "Service": {
      "title": "Service",
      "description": "Digital agency service offerings and discipline pillars",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique service identifier" },
        "title": { "type": "string", "description": "Name of the service category" },
        "banglaTitle": { "type": "string", "description": "Bangla translated title" },
        "iconName": { "type": "string", "description": "Lucide icon identifier" },
        "tagline": { "type": "string", "description": "Punchy value proposition" },
        "description": { "type": "string", "description": "Detailed explanation of service scope" },
        "accentColor": { "type": "string", "description": "Color theme accent for UI" },
        "startingPrice": { "type": "string", "description": "Pricing tier starting point" },
        "turnaroundTime": { "type": "string", "description": "Estimated turnaround delivery duration" },
        "highlightMetric": { "type": "string", "description": "Key quantifiable performance metric" },
        "keyFeatures": { "type": "array", "description": "List of core features included" },
        "deliverables": { "type": "array", "description": "Handover deliverables provided" },
        "techStack": { "type": "array", "description": "Technologies and tools utilized" },
        "bn": { "type": "object", "description": "Bangla localization overrides" },
        "es": { "type": "object", "description": "Spanish localization overrides" }
      },
      "required": ["id", "title", "tagline", "description", "startingPrice"]
    },
    "Project": {
      "title": "Project",
      "description": "Agency portfolio case study showcase project with rich storytelling and media",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique project identifier" },
        "title": { "type": "string", "description": "Headline project title" },
        "slug": { "type": "string", "description": "URL-friendly project slug" },
        "subtitle": { "type": "string", "description": "Project subtitle or focus area" },
        "description": { "type": "string", "description": "Executive project overview narrative" },
        "category": { "type": "string", "description": "Service category discipline" },
        "clientName": { "type": "string", "description": "Client company name and location" },
        "client": { "type": "string", "description": "Legacy client company name alias" },
        "year": { "type": "number", "description": "Year of release integer" },
        "featured": { "type": "boolean", "description": "Featured on homepage showcase flag" },
        "isPublished": { "type": "boolean", "description": "Public visibility publishing status" },
        "thumbnailUrl": { "type": "string", "description": "Thumbnail card image URL" },
        "thumbnail": { "type": "string", "description": "Legacy thumbnail URL alias" },
        "heroImageUrl": { "type": "string", "description": "Cinematic hero cover image URL" },
        "gallery": { "type": "array", "description": "List of gallery images with url, alt, caption" },
        "galleryImages": { "type": "array", "description": "Legacy gallery screenshots list" },
        "videoUrl": { "type": "string", "description": "Video preview or showcase URL" },
        "videoPreviewUrl": { "type": "string", "description": "Legacy video preview URL alias" },
        "videoDuration": { "type": "string", "description": "Duration string for video projects" },
        "liveUrl": { "type": "string", "description": "Live production client website URL" },
        "services": { "type": "array", "description": "List of delivered services" },
        "technologies": { "type": "array", "description": "Technologies and tools utilized" },
        "techStack": { "type": "array", "description": "Legacy technologies array" },
        "challenge": { "type": "string", "description": "Case study initial challenge statement" },
        "solution": { "type": "string", "description": "Delivered agency solution" },
        "results": { "type": "array", "description": "List of result metrics with label and value" },
        "metrics": { "type": "array", "description": "Legacy metric badges" },
        "tags": { "type": "array", "description": "Keyword tags" },
        "sortOrder": { "type": "number", "description": "Ordering priority integer" },
        "createdAt": { "type": "string", "description": "ISO timestamp of creation" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" }
      },
      "required": ["id", "title", "category"]
    },
    "Lead": {
      "title": "Lead",
      "description": "CRM client lead records and inquiries",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Lead contact name" },
        "email": { "type": "string", "format": "email", "description": "Lead email address" },
        "phone": { "type": "string", "description": "Lead phone number" },
        "company": { "type": "string", "description": "Lead organization" },
        "services": { "type": "array", "description": "Requested service disciplines" },
        "budget": { "type": "string", "description": "Estimated budget tier" },
        "timeline": { "type": "string", "description": "Target delivery timeline" },
        "description": { "type": "string", "description": "Project requirements brief" },
        "status": { "type": "string", "enum": ["new", "reviewing", "quoted", "closed", "contacted", "qualified", "proposal", "converted", "lost"], "description": "CRM pipeline status" },
        "estimatedValue": { "type": "number", "description": "Estimated pipeline deal value in USD" },
        "userId": { "type": "string", "description": "Optional authenticated client user UID" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["name", "email", "status"]
    },
    "AiPlan": {
      "title": "AiPlan",
      "description": "AI-generated project architecture plans",
      "type": "object",
      "properties": {
        "plan": { "type": "object", "description": "Full structured plan object" },
        "userId": { "type": "string", "description": "Authenticated user UID" },
        "userEmail": { "type": "string", "description": "User email address" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["plan", "userId"]
    },
    "NewsletterSubscriber": {
      "title": "NewsletterSubscriber",
      "description": "Newsletter mailing list entry",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "description": "Subscriber email" },
        "topics": { "type": "array", "description": "Subscribed topics" },
        "subscribedAt": { "type": "string", "description": "Subscription timestamp" }
      },
      "required": ["email", "subscribedAt"]
    },
    "BlogPostComment": {
      "title": "BlogPostComment",
      "description": "Comment and discussion entry on blog posts",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Author name" },
        "email": { "type": "string", "description": "Author email" },
        "avatar": { "type": "string", "description": "Avatar URL" },
        "text": { "type": "string", "description": "Comment text" },
        "createdAt": { "type": "string", "description": "Comment timestamp" }
      },
      "required": ["name", "text", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles with role-based access control"
    },
    "/serviceRequests/{requestId}": {
      "schema": "ServiceRequest",
      "description": "Client service requests with specifications and attachments"
    },
    "/projects/{projectId}": {
      "schema": "ClientProject",
      "description": "Active production sprints and projects"
    },
    "/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Direct communication between clients and studio admins"
    },
    "/contactMessages/{messageId}": {
      "schema": "ContactMessage",
      "description": "Public contact form submissions and inquiries"
    },
    "/testimonials/{testimonialId}": {
      "schema": "TestimonialDoc",
      "description": "Client reviews and ratings"
    },
    "/notifications/{notificationId}": {
      "schema": "AppNotification",
      "description": "In-app notifications for clients and admins"
    },
    "/activityLogs/{logId}": {
      "schema": "ActivityLog",
      "description": "Audit trail log of all administrative and client actions"
    },
    "/services/{serviceId}": {
      "schema": "Service",
      "description": "Agency service offerings and pricing tiers"
    },
    "/portfolio/{projectId}": {
      "schema": "Project",
      "description": "Agency case studies and project showcase"
    },
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "Client CRM project inquiries and quote submissions"
    },
    "/user_ai_plans/{planId}": {
      "schema": "AiPlan",
      "description": "Saved AI project architectural blueprints"
    },
    "/newsletter_subscribers/{subId}": {
      "schema": "NewsletterSubscriber",
      "description": "Newsletter mailing list subscribers"
    },
    "/blog_posts/{postId}/comments/{commentId}": {
      "schema": "BlogPostComment",
      "description": "Comments and community feedback on blog posts"
    }
  }
}
